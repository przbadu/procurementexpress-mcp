{
  "name": "@procurementexpress.com/mcp",
  "version": "3.0.0",
  "description": "MCP server for ProcurementExpress API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "procurementexpress-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "procurementexpress",
    "procurement",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "files": [
    "dist",
    ".claude/skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/procurementexpress/mcp.git"
  },
  "homepage": "https://github.com/procurementexpress/mcp#readme",
  "bugs": {
    "url": "https://github.com/procurementexpress/mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
